# WhatsApp Node servisi — örnek ortam
PORT=3001

# Eşzamanlı Chrome limiti (Render: 2 önerilir)
WA_MAX_CONCURRENT_CHROME=2

# Idle destroy: 20 dakika kullanılmayan kiracı oturumu (default hariç)
WA_IDLE_MS=1200000
WA_IDLE_CHECK_MS=60000

# Render'da true; yerelde false bırakılabilir
WA_HEADLESS=false

# Flask ile AYNI değer olmalı — üretimde güçlü secret kullanın
WA_INTERNAL_TOKEN=bestoffice-wa-internal

# Opsiyonel Chrome yolu
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
